# Modelo das variáveis de ambiente. Copie para .env.local (ignorado pelo git), preencha
# e carregue no shell (`set -a; . ./.env.local; set +a`), ou passe na linha de comando.
# Nenhum script lê esse arquivo sozinho. Nunca versione valores reais.

# Gerar o catálogo real (pnpm catalog): chave da YouTube Data API v3
YOUTUBE_API_KEY=

# Instalar na TV (android/scripts/install-tv.sh e tizen/scripts/install-tv.sh)
TV_IP=

# Publicar o site (pnpm publish:site): ver web/.publish.local, também ignorado
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PAGES_PROJECT=
