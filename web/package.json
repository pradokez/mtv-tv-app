{
  "name": "mtv-tv-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:tizen": "tsc --noEmit && vite build --mode tizen && node scripts/check-bundle.ts dist-tizen",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "catalog": "node scripts/catalog-builder/main.ts",
    "publish:site": "node scripts/publish/main.ts publish",
    "publish:list": "node scripts/publish/main.ts deploys",
    "publish:rollback": "node scripts/publish/main.ts rollback"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "4.162.0"
  }
}
